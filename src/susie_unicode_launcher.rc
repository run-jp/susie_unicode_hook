#include "version.h"

IDI_ICON1 ICON "susie_icon.ico"

1 VERSIONINFO
FILEVERSION     SUH_VERSION_MAJOR,SUH_VERSION_MINOR,SUH_VERSION_PATCH,0
PRODUCTVERSION  SUH_VERSION_MAJOR,SUH_VERSION_MINOR,SUH_VERSION_PATCH,0
FILEFLAGSMASK   0x3FL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Susie for Win32 Unicode path name hook launcher"
            VALUE "FileVersion",      SUH_VERSION_STR
            VALUE "InternalName",     "SusieUnicode"
            VALUE "OriginalFilename", "SusieUnicode.exe"
            VALUE "ProductName",      "susie_unicode_hook"
            VALUE "ProductVersion",   SUH_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

